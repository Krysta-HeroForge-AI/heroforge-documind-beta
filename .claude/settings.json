{
  "features": {
    "skills": {
      "enabled": true
    },
    "hooks": {
      "enabled": true
    },
    "subagents": {
      "enabled": true
    },
    "mcp": {
      "enabled": true
    }
  },
  "mcpServers": {
    "documind-mcp": {
      "command": "python",
      "args": ["-m", "src.mcp.server"],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_KEY": "${SUPABASE_SERVICE_KEY}"
      }
    }
  }
}
