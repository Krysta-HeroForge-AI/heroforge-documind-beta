+"""
+Tests for DocuMind Document Processor
+
+Session 3: Basic document processing tests
+"""
+
+import pytest
+import tempfile
+import os
+from pathlib import Path
+
+from src.documind.document_processor import (
+    DocumentProcessor,
+    ProcessedDocument,
+    DocumentMetadata,
+    process_document,
+)
+
+
+class TestDocumentProcessor:
+    """Test suite for DocumentProcessor class."""
+
+    def setup_method(self):
+        """Set up test fixtures."""
+        self.processor = DocumentProcessor()
+        self.temp_dir = tempfile.mkdtemp()
+
+    def teardown_method(self):
+        """Clean up test fixtures."""
+        import shutil
+        shutil.rmtree(self.temp_dir, ignore_errors=True)
+
+    def _create_temp_file(self, filename: str, content: str) -> str:
+        """Create a temporary file with content."""
+        filepath = os.path.join(self.temp_dir, filename)
+        with open(filepath, "w", encoding="utf-8") as f:
+            f.write(content)
+        return filepath
+
+    def test_process_text_file(self):
+        """Test processing a plain text file."""
+        content = "This is a test document.\nIt has multiple lines."
+        filepath = self._create_temp_file("test.txt", content)
+
+        result = self.processor.process_file(filepath)
+
+        assert result.success is True
+        assert result.content == content
+        assert result.metadata.file_type == "text"
+        assert result.metadata.word_count == 9
+        assert result.id.startswith("doc_")
+
+    def test_process_markdown_file(self):
+        """Test processing a markdown file with title extraction."""
+        content = "# My Document Title\n\nThis is the content.\n\n## Section 1\n\nMore content."
+        filepath = self._create_temp_file("test.md", content)
+
+        result = self.processor.process_file(filepath)
+
+        assert result.success is True
+        assert result.title == "My Document Title"
+        assert result.metadata.file_type == "markdown"
+        assert "## Section 1" in result.content
+
+    def test_process_markdown_without_title(self):
+        """Test markdown file without h1 title."""
+        content = "Some content without a header title."
+        filepath = self._create_temp_file("notitle.md", content)
+
+        result = self.processor.process_file(filepath)
+
+        assert result.success is True
+        assert result.title == "notitle"  # Uses filename stem
+
+    def test_process_nonexistent_file(self):
+        """Test processing a file that doesn't exist."""
+        result = self.processor.process_file("/nonexistent/path/file.txt")
+
+        assert result.success is False
+        assert "not found" in result.error.lower()
+
+    def test_process_unsupported_type(self):
+        """Test processing an unsupported file type."""
+        filepath = self._create_temp_file("test.xyz", "content")
+
+        result = self.processor.process_file(filepath)
+
+        assert result.success is False
+        assert "unsupported" in result.error.lower()
+
+    def test_process_content_directly(self):
+        """Test processing raw content without a file."""
+        content = "Direct content processing test."
+
+        result = self.processor.process_content(
+            content=content,
+            title="Direct Input",
+            file_type="text"
+        )
+
+        assert result.success is True
+        assert result.title == "Direct Input"
+        assert result.content == content
+        assert result.metadata.source_path == "<direct_input>"
+
+    def test_metadata_generation(self):
+        """Test that metadata is correctly generated."""
+        content = "Word one two three four five."
+        filepath = self._create_temp_file("meta_test.txt", content)
+
+        result = self.processor.process_file(filepath)
+
+        assert result.success is True
+        assert result.metadata.word_count == 6
+        assert result.metadata.char_count == len(content)
+        assert result.metadata.file_size > 0
+        assert result.metadata.content_hash != ""
+
+    def test_document_id_uniqueness(self):
+        """Test that different content produces different IDs."""
+        content1 = "First document content."
+        content2 = "Second document content."
+        filepath1 = self._create_temp_file("doc1.txt", content1)
+        filepath2 = self._create_temp_file("doc2.txt", content2)
+
+        result1 = self.processor.process_file(filepath1)
+        result2 = self.processor.process_file(filepath2)
+
+        assert result1.id != result2.id
+
+    def test_convenience_function(self):
+        """Test the process_document convenience function."""
+        content = "Test content for convenience function."
+        filepath = self._create_temp_file("convenience.txt", content)
+
+        result = process_document(filepath)
+
+        assert result.success is True
+        assert result.content == content
+
+
+class TestProcessedDocument:
+    """Test suite for ProcessedDocument dataclass."""
+
+    def test_to_dict(self):
+        """Test conversion to dictionary."""
