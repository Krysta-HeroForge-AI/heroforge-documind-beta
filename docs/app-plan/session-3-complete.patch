+"""
+DocuMind OpenRouter Client
+
+Multi-model LLM gateway for flexible model selection.
+Supports Claude, GPT-4, Gemini, and other models via OpenRouter.
+
+Session 3: Foundation setup
+Session 6+: Used for RAG answer generation
+"""
+
+import os
+import json
+from typing import Optional, Dict, Any, List
+from dataclasses import dataclass
+import urllib.request
+import urllib.error
+
+
+@dataclass
+class OpenRouterConfig:
+    """Configuration for OpenRouter client."""
+    api_key: str
+    default_model: str = "anthropic/claude-3.5-sonnet"
+    base_url: str = "https://openrouter.ai/api/v1"
+    max_tokens: int = 4096
+    temperature: float = 0.7
+    site_url: str = "https://documind.app"
+    site_name: str = "DocuMind"
+
+
+class OpenRouterClient:
+    """
+    Client for OpenRouter multi-model API.
+
+    Provides a unified interface to multiple LLM providers:
+    - Anthropic (Claude)
+    - OpenAI (GPT-4)
+    - Google (Gemini)
+    - And many more
+
+    Usage:
+        client = OpenRouterClient()
+        response = client.chat("What is the vacation policy?", context="...")
+    """
+
+    # Available models with cost indicators
+    MODELS = {
+        # Anthropic
+        "anthropic/claude-3.5-sonnet": {"name": "Claude 3.5 Sonnet", "cost": "$$"},
+        "anthropic/claude-3-haiku": {"name": "Claude 3 Haiku", "cost": "$"},
+        # OpenAI
+        "openai/gpt-4-turbo": {"name": "GPT-4 Turbo", "cost": "$$$"},
+        "openai/gpt-4o": {"name": "GPT-4o", "cost": "$$"},
+        "openai/gpt-4o-mini": {"name": "GPT-4o Mini", "cost": "$"},
+        # Google
+        "google/gemini-pro-1.5": {"name": "Gemini Pro 1.5", "cost": "$$"},
+        "google/gemini-flash-1.5": {"name": "Gemini Flash", "cost": "$"},
+    }
+
+    def __init__(self, config: Optional[OpenRouterConfig] = None):
+        """
+        Initialize OpenRouter client.
+
+        Args:
+            config: Optional configuration. If not provided, reads from environment.
+        """
+        if config:
+            self.config = config
+        else:
+            api_key = os.getenv("OPENROUTER_API_KEY", "")
+            default_model = os.getenv("DEFAULT_LLM_MODEL", "anthropic/claude-3.5-sonnet")
+            self.config = OpenRouterConfig(api_key=api_key, default_model=default_model)
+
+        self._validate_config()
+
+    def _validate_config(self) -> None:
+        """Validate configuration."""
+        if not self.config.api_key:
+            print("Warning: OPENROUTER_API_KEY not set. API calls will fail.")
+
+    def list_models(self) -> Dict[str, Dict[str, str]]:
+        """
+        List available models.
+
+        Returns:
+            Dictionary of model IDs to model info
+        """
+        return self.MODELS
+
+    def chat(
+        self,
+        message: str,
+        context: Optional[str] = None,
+        system_prompt: Optional[str] = None,
+        model: Optional[str] = None,
+        temperature: Optional[float] = None,
+        max_tokens: Optional[int] = None,
+    ) -> Dict[str, Any]:
+        """
+        Send a chat completion request.
+
+        Args:
+            message: User message/query
+            context: Optional context (e.g., retrieved documents for RAG)
+            system_prompt: Optional system prompt override
+            model: Model to use (defaults to config default)
+            temperature: Temperature for generation
+            max_tokens: Max tokens to generate
+
+        Returns:
+            Response dictionary with 'content', 'model', 'usage'
+        """
+        model = model or self.config.default_model
+        temperature = temperature if temperature is not None else self.config.temperature
+        max_tokens = max_tokens or self.config.max_tokens
+
+        # Build messages
+        messages = []
+
+        # System prompt
+        if system_prompt:
+            messages.append({"role": "system", "content": system_prompt})
+        else:
+            messages.append({
+                "role": "system",
+                "content": self._default_system_prompt()
+            })
+
+        # Add context if provided (for RAG)
+        if context:
+            messages.append({
+                "role": "user",
+                "content": f"Here is relevant context from our knowledge base:\n\n{context}\n\n---\n\nBased on the above context, please answer the following question:"
+            })
+
+        # Add user message
+        messages.append({"role": "user", "content": message})
+
+        # Make API request
+        return self._make_request(
+            messages=messages,
+            model=model,
+            temperature=temperature,
+            max_tokens=max_tokens
+        )
+
+    def _default_system_prompt(self) -> str:
+        """Default system prompt for DocuMind."""
+        return """You are DocuMind, an intelligent assistant for company knowledge bases.
+
+Your role is to:
+1. Answer questions accurately based on provided context
+2. Always cite your sources when information comes from documents
+3. Be concise but thorough
+4. Admit when you don't have enough information to answer
+5. Never make up information not present in the context
+
+When answering:
+- Start with a direct answer
+- Provide supporting details from the context
+- Include source citations in [brackets]
+- Suggest related topics if relevant"""
+
+    def _make_request(
+        self,
+        messages: List[Dict[str, str]],
+        model: str,
+        temperature: float,
+        max_tokens: int
+    ) -> Dict[str, Any]:
+        """
+        Make HTTP request to OpenRouter API.
+
+        Uses urllib to avoid external dependencies.
+        """
+        if not self.config.api_key:
+            return {
+                "success": False,
+                "error": "OPENROUTER_API_KEY not configured",
+                "content": None
+            }
+
+        url = f"{self.config.base_url}/chat/completions"
+
+        payload = {
+            "model": model,
+            "messages": messages,
+            "temperature": temperature,
+            "max_tokens": max_tokens,
+        }
+
+        headers = {
+            "Authorization": f"Bearer {self.config.api_key}",
+            "Content-Type": "application/json",
+            "HTTP-Referer": self.config.site_url,
+            "X-Title": self.config.site_name,
+        }
+
+        try:
+            data = json.dumps(payload).encode("utf-8")
+            req = urllib.request.Request(url, data=data, headers=headers, method="POST")
+
+            with urllib.request.urlopen(req, timeout=60) as response:
+                result = json.loads(response.read().decode("utf-8"))
+
+                return {
+                    "success": True,
+                    "content": result["choices"][0]["message"]["content"],
+                    "model": result.get("model", model),
+                    "usage": result.get("usage", {}),
+                    "raw_response": result
+                }
+
+        except urllib.error.HTTPError as e:
+            error_body = e.read().decode("utf-8") if e.fp else str(e)
+            return {
+                "success": False,
+                "error": f"HTTP {e.code}: {error_body}",
+                "content": None
+            }
+        except urllib.error.URLError as e:
+            return {
+                "success": False,
+                "error": f"URL Error: {str(e)}",
+                "content": None
+            }
+        except Exception as e:
+            return {
+                "success": False,
+                "error": f"Error: {str(e)}",
+                "content": None
+            }
+
+    def compare_models(
+        self,
+        message: str,
+        context: Optional[str] = None,
+        models: Optional[List[str]] = None
+    ) -> Dict[str, Dict[str, Any]]:
+        """
+        Compare responses from multiple models.
+
+        Useful for A/B testing and model selection (Session 10).
+
+        Args:
+            message: Query to send to all models
+            context: Optional context for RAG
+            models: List of models to compare (defaults to top 3)
+
+        Returns:
+            Dictionary mapping model ID to response
+        """
+        if models is None:
+            models = [
+                "anthropic/claude-3.5-sonnet",
+                "openai/gpt-4o",
+                "google/gemini-pro-1.5"
+            ]
+
+        results = {}
+        for model in models:
+            print(f"Querying {model}...")
+            results[model] = self.chat(
+                message=message,
+                context=context,
+                model=model
+            )
+
+        return results
+
+
+# Convenience function for quick usage
+def get_client() -> OpenRouterClient:
+    """Get a configured OpenRouter client."""
+    return OpenRouterClient()
+
+
+# CLI for testing
+if __name__ == "__main__":
+    import sys
+
+    client = get_client()
+
+    print("DocuMind OpenRouter Client")
+    print("=" * 40)
+    print(f"Default model: {client.config.default_model}")
+    print(f"API key configured: {'Yes' if client.config.api_key else 'No'}")
+    print()
+
+    print("Available models:")
+    for model_id, info in client.list_models().items():
+        print(f"  {info['cost']} {model_id} ({info['name']})")
+
+    if len(sys.argv) > 1:
+        query = " ".join(sys.argv[1:])
+        print(f"\nQuery: {query}")
+        print("-" * 40)
+        response = client.chat(query)
+        if response["success"]:
+            print(response["content"])
+        else:
+            print(f"Error: {response['error']}")
