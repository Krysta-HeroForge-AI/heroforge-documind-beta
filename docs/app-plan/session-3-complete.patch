+#!/bin/bash
+# DocuMind Pre-Commit Format Hook
+# Automatically formats files before commit
+#
+# Session 3: Skills, Subagents, Hooks
+# This hook demonstrates Claude Code hook automation
+
+set -e
+
+# Colors for output
+RED='\033[0;31m'
+GREEN='\033[0;32m'
+YELLOW='\033[1;33m'
+NC='\033[0m' # No Color
+
+echo -e "${YELLOW}[DocuMind] Running pre-commit formatting...${NC}"
+
+# Get list of staged files
+STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || echo "")
+
+if [ -z "$STAGED_FILES" ]; then
+    echo -e "${GREEN}[DocuMind] No staged files to format${NC}"
+    exit 0
+fi
+
+# Track if any files were modified
+FILES_MODIFIED=0
+
+# Format Python files with black (if available)
+PYTHON_FILES=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
+if [ -n "$PYTHON_FILES" ]; then
+    if command -v black &> /dev/null; then
+        echo -e "${YELLOW}[DocuMind] Formatting Python files with black...${NC}"
+        echo "$PYTHON_FILES" | xargs black --quiet 2>/dev/null || true
+        FILES_MODIFIED=1
+    else
+        echo -e "${YELLOW}[DocuMind] black not installed, skipping Python formatting${NC}"
+    fi
+fi
+
+# Format JavaScript/TypeScript files with prettier (if available)
+JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|jsx|tsx)$' || true)
+if [ -n "$JS_FILES" ]; then
+    if command -v prettier &> /dev/null; then
+        echo -e "${YELLOW}[DocuMind] Formatting JS/TS files with prettier...${NC}"
+        echo "$JS_FILES" | xargs prettier --write --log-level error 2>/dev/null || true
+        FILES_MODIFIED=1
+    else
+        echo -e "${YELLOW}[DocuMind] prettier not installed, skipping JS/TS formatting${NC}"
+    fi
+fi
+
+# Format JSON files with prettier (if available)
+JSON_FILES=$(echo "$STAGED_FILES" | grep -E '\.json$' || true)
+if [ -n "$JSON_FILES" ]; then
+    if command -v prettier &> /dev/null; then
+        echo -e "${YELLOW}[DocuMind] Formatting JSON files with prettier...${NC}"
+        echo "$JSON_FILES" | xargs prettier --write --log-level error 2>/dev/null || true
+        FILES_MODIFIED=1
+    fi
+fi
+
+# Clean up Markdown files
+MD_FILES=$(echo "$STAGED_FILES" | grep -E '\.md$' || true)
+if [ -n "$MD_FILES" ]; then
+    echo -e "${YELLOW}[DocuMind] Cleaning up Markdown files...${NC}"
+    for file in $MD_FILES; do
+        if [ -f "$file" ]; then
+            # Remove trailing whitespace
+            sed -i 's/[[:space:]]*$//' "$file" 2>/dev/null || true
+            # Ensure file ends with newline
+            if [ -n "$(tail -c 1 "$file")" ]; then
+                echo "" >> "$file"
+            fi
+            FILES_MODIFIED=1
+        fi
+    done
+fi
+
+# Re-add modified files to staging
+if [ $FILES_MODIFIED -eq 1 ]; then
+    echo "$STAGED_FILES" | xargs git add 2>/dev/null || true
+    echo -e "${GREEN}[DocuMind] Files formatted and re-staged${NC}"
+fi
+
+echo -e "${GREEN}[DocuMind] Pre-commit formatting complete${NC}"
+exit 0
