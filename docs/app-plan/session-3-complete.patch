+"""
+DocuMind Document Processor
+
+Handles document ingestion, text extraction, and metadata parsing.
+This is the Python implementation backing the document-processor skill.
+
+Session 3: Basic text/markdown support
+Session 7: Extended with PDF, DOCX, XLSX support
+"""
+
+import os
+import json
+from datetime import datetime
+from typing import Optional, Dict, Any, Tuple
+from dataclasses import dataclass, asdict
+from pathlib import Path
+import hashlib
+
+
+@dataclass
+class DocumentMetadata:
+    """Metadata extracted from a document."""
+    title: str
+    file_type: str
+    file_size: int
+    word_count: int
+    char_count: int
+    source_path: str
+    created_at: str
+    content_hash: str
+
+    def to_dict(self) -> Dict[str, Any]:
+        return asdict(self)
+
+
+@dataclass
+class ProcessedDocument:
+    """Result of document processing."""
+    id: str
+    title: str
+    content: str
+    metadata: DocumentMetadata
+    success: bool
+    error: Optional[str] = None
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "id": self.id,
+            "title": self.title,
+            "content": self.content,
+            "metadata": self.metadata.to_dict(),
+            "success": self.success,
+            "error": self.error
+        }
+
+    def to_json(self) -> str:
+        return json.dumps(self.to_dict(), indent=2)
+
+
+class DocumentProcessor:
+    """
+    Process documents for DocuMind knowledge base.
+
+    Supported formats (Session 3):
+    - Plain text (.txt)
+    - Markdown (.md)
+
+    Extended formats (Session 7):
+    - PDF (.pdf)
+    - Word (.docx)
+    - Excel (.xlsx, .csv)
+
+    Usage:
+        processor = DocumentProcessor()
+        result = processor.process_file("/path/to/document.md")
+        if result.success:
+            print(result.content)
+    """
+
+    # Supported file extensions and their types
+    SUPPORTED_TYPES = {
+        ".txt": "text",
+        ".md": "markdown",
+        ".markdown": "markdown",
+        # Session 7 additions (placeholders)
+        ".pdf": "pdf",
+        ".docx": "docx",
+        ".xlsx": "xlsx",
+        ".csv": "csv",
+    }
+
+    def __init__(self, base_path: Optional[str] = None):
+        """
+        Initialize document processor.
+
+        Args:
+            base_path: Optional base path for resolving relative paths
+        """
+        self.base_path = Path(base_path) if base_path else Path.cwd()
+
+    def process_file(self, file_path: str) -> ProcessedDocument:
+        """
+        Process a single file.
+
+        Args:
+            file_path: Path to the file to process
+
+        Returns:
+            ProcessedDocument with content and metadata
+        """
+        path = self._resolve_path(file_path)
+
+        # Validate file exists
+        if not path.exists():
+            return self._error_result(file_path, f"File not found: {path}")
+
+        if not path.is_file():
+            return self._error_result(file_path, f"Not a file: {path}")
+
+        # Check file type
+        file_type = self._get_file_type(path)
+        if file_type is None:
+            return self._error_result(
+                file_path,
+                f"Unsupported file type: {path.suffix}"
+            )
+
+        # Extract content based on type
+        try:
+            content, title = self._extract_content(path, file_type)
+        except Exception as e:
+            return self._error_result(file_path, f"Extraction error: {str(e)}")
+
+        # Generate metadata
+        metadata = self._generate_metadata(path, content, file_type)
+
+        # Generate document ID
+        doc_id = self._generate_id(path, content)
+
+        return ProcessedDocument(
+            id=doc_id,
+            title=title or path.stem,
+            content=content,
+            metadata=metadata,
+            success=True
+        )
+
+    def process_content(
+        self,
+        content: str,
+        title: str = "Untitled",
+        file_type: str = "text"
+    ) -> ProcessedDocument:
+        """
+        Process raw content (not from file).
+
+        Args:
+            content: Raw text content
+            title: Document title
+            file_type: Type of content
+
+        Returns:
+            ProcessedDocument
+        """
+        doc_id = self._generate_id_from_content(content)
+
+        metadata = DocumentMetadata(
+            title=title,
+            file_type=file_type,
+            file_size=len(content.encode("utf-8")),
+            word_count=len(content.split()),
+            char_count=len(content),
+            source_path="<direct_input>",
+            created_at=datetime.utcnow().isoformat() + "Z",
+            content_hash=hashlib.md5(content.encode()).hexdigest()
+        )
+
+        return ProcessedDocument(
+            id=doc_id,
+            title=title,
+            content=content,
+            metadata=metadata,
+            success=True
+        )
+
+    def _resolve_path(self, file_path: str) -> Path:
+        """Resolve file path, handling relative paths."""
+        path = Path(file_path)
+        if not path.is_absolute():
+            path = self.base_path / path
+        return path.resolve()
+
+    def _get_file_type(self, path: Path) -> Optional[str]:
+        """Get file type from extension."""
+        return self.SUPPORTED_TYPES.get(path.suffix.lower())
+
+    def _extract_content(self, path: Path, file_type: str) -> Tuple[str, Optional[str]]:
+        """
+        Extract content and title from file.
+
+        Returns:
+            Tuple of (content, title)
+        """
+        if file_type in ("text", "markdown"):
+            return self._extract_text(path)
+        elif file_type == "pdf":
+            return self._extract_pdf(path)
+        elif file_type == "docx":
+            return self._extract_docx(path)
+        elif file_type in ("xlsx", "csv"):
+            return self._extract_spreadsheet(path, file_type)
+        else:
+            raise ValueError(f"Unknown file type: {file_type}")
+
+    def _extract_text(self, path: Path) -> Tuple[str, Optional[str]]:
+        """Extract content from text/markdown file."""
+        with open(path, "r", encoding="utf-8") as f:
+            content = f.read()
+
+        # Try to extract title from markdown
+        title = None
+        if path.suffix.lower() in (".md", ".markdown"):
+            lines = content.split("\n")
+            for line in lines:
+                line = line.strip()
+                if line.startswith("# "):
+                    title = line[2:].strip()
+                    break
+
+        return content, title
+
+    def _extract_pdf(self, path: Path) -> Tuple[str, Optional[str]]:
+        """
+        Extract content from PDF file.
+
+        Session 7: Full implementation with PyPDF2/pdfplumber
+        """
+        # Placeholder for Session 7
+        raise NotImplementedError(
+            "PDF extraction available in Session 7. "
+            "Install: pip install PyPDF2 pdfplumber"
+        )
+
+    def _extract_docx(self, path: Path) -> Tuple[str, Optional[str]]:
+        """
+        Extract content from Word document.
+
+        Session 7: Full implementation with python-docx
+        """
+        # Placeholder for Session 7
+        raise NotImplementedError(
+            "DOCX extraction available in Session 7. "
+            "Install: pip install python-docx"
+        )
+
+    def _extract_spreadsheet(self, path: Path, file_type: str) -> Tuple[str, Optional[str]]:
+        """
+        Extract content from spreadsheet.
+
+        Session 7: Full implementation with pandas/openpyxl
+        """
+        # Placeholder for Session 7
+        raise NotImplementedError(
+            "Spreadsheet extraction available in Session 7. "
+            "Install: pip install pandas openpyxl"
+        )
+
+    def _generate_metadata(
+        self,
+        path: Path,
+        content: str,
+        file_type: str
+    ) -> DocumentMetadata:
+        """Generate metadata for a document."""
+        stat = path.stat()
+
+        return DocumentMetadata(
+            title=path.stem,
+            file_type=file_type,
+            file_size=stat.st_size,
+            word_count=len(content.split()),
+            char_count=len(content),
+            source_path=str(path),
+            created_at=datetime.fromtimestamp(stat.st_mtime).isoformat() + "Z",
+            content_hash=hashlib.md5(content.encode()).hexdigest()
+        )
+
+    def _generate_id(self, path: Path, content: str) -> str:
+        """Generate unique document ID."""
+        hash_input = f"{path}:{content[:1000]}"
+        return f"doc_{hashlib.sha256(hash_input.encode()).hexdigest()[:12]}"
+
+    def _generate_id_from_content(self, content: str) -> str:
+        """Generate ID from content only."""
+        return f"doc_{hashlib.sha256(content.encode()).hexdigest()[:12]}"
+
+    def _error_result(self, file_path: str, error: str) -> ProcessedDocument:
+        """Create error result."""
+        return ProcessedDocument(
+            id="",
+            title=Path(file_path).stem if file_path else "Unknown",
+            content="",
+            metadata=DocumentMetadata(
+                title="",
+                file_type="unknown",
+                file_size=0,
+                word_count=0,
+                char_count=0,
+                source_path=file_path,
+                created_at=datetime.utcnow().isoformat() + "Z",
+                content_hash=""
+            ),
+            success=False,
+            error=error
+        )
+
+
+# Convenience function
+def process_document(file_path: str) -> ProcessedDocument:
+    """Process a document file."""
+    processor = DocumentProcessor()
+    return processor.process_file(file_path)
+
+
+# CLI for testing
+if __name__ == "__main__":
+    import sys
+
+    if len(sys.argv) < 2:
+        print("Usage: python document_processor.py <file_path>")
+        print("\nSupported types: .txt, .md")
+        print("Session 7 adds: .pdf, .docx, .xlsx, .csv")
+        sys.exit(1)
+
+    file_path = sys.argv[1]
+    processor = DocumentProcessor()
+    result = processor.process_file(file_path)
+
+    if result.success:
+        print(f"Document ID: {result.id}")
+        print(f"Title: {result.title}")
+        print(f"Type: {result.metadata.file_type}")
+        print(f"Words: {result.metadata.word_count}")
+        print(f"Characters: {result.metadata.char_count}")
+        print("-" * 40)
+        print("Content preview:")
+        print(result.content[:500] + "..." if len(result.content) > 500 else result.content)
+    else:
+        print(f"Error: {result.error}")
+        sys.exit(1)
